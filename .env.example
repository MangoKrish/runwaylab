# Copy this file to .env.local and fill it in. .env.local is never copied into the build.
# Every line is optional for trying things locally. Without them you get the measured half and a local test wall.

# ── Gemini judge ──
# Get a key at https://aistudio.google.com/apikey (the HackTrent shortcut is mlh.link/aistudio).
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Set to 1 only if this key's Google project has billing on. It changes what the consent text says:
# free-tier content may be used to improve Google's products, and the app tells people so.
# GEMINI_PAID_TIER=1

# ── The wall ──
# Tiger Data connection string. Then run: node scripts/wall-db.mjs setup
# DATABASE_URL=

# Required once deployed: signs judge results and sign-in sessions. Make one with: openssl rand -base64 32
# WALL_SECRET=

# ── Sign-in, optional. Without these, anyone can post with a name. ──
# In Auth0, create a Regular Web Application, and add the address ending /api/auth-callback to Allowed Callback URLs.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
